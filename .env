# Ambiente de Produção
NODE_ENV=production

# Configurações do Banco de Dados
DB_HOST=localhost
DB_PORT=3306
DB_NAME=treinamento_bot_prod
DB_USER=bot_user
DB_PASS=sua_senha_segura_aqui

# Configurações de Segurança
JWT_SECRET=sua_chave_jwt_muito_segura_com_pelo_menos_32_caracteres
SESSION_SECRET=sua_chave_sessao_muito_segura_com_pelo_menos_32_caracteres

# Configurações de Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_app_gmail

# Configurações do WhatsApp
WHATSAPP_SESSION_PATH=./sessions
WHATSAPP_TIMEOUT=60000

# Configurações de Log
LOG_LEVEL=error
LOG_FILE=./logs/production.log

# Configurações de Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# Configurações de Certificados
CERT_OUTPUT_PATH=./certificados
CERT_TEMPLATE_PATH=./templates

# Configurações de Backup
BACKUP_ENABLED=true
BACKUP_INTERVAL=86400000
BACKUP_PATH=./backups

# Configurações de Monitoramento
HEALTH_CHECK_PORT=3001
METRICS_ENABLED=true