# Exemplo de configuração - Copie para .env e configure
NODE_ENV=development

# Banco de Dados
DB_HOST=localhost
DB_PORT=3306
DB_NAME=treinamento_bot
DB_USER=root
DB_PASS=sua_senha

# Segurança
JWT_SECRET=sua_chave_jwt_32_caracteres_minimo
SESSION_SECRET=sua_chave_sessao_32_caracteres_minimo

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_app

# WhatsApp
WHATSAPP_SESSION_PATH=./sessions
WHATSAPP_TIMEOUT=60000

# Logs
LOG_LEVEL=info
LOG_FILE=./logs/app.log